PORT=5001
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
GROQ_API_KEY=your_groq_api_key_for_ai_chat
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=you@example.com
# For local development, set a password directly. Keep this file private.
ADMIN_PASSWORD=choose-a-strong-local-password
# Generate with: node -e "require('bcryptjs').hash('choose-a-long-password', 12).then(console.log)"
# For deployment, prefer ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
# Generate each secret with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
COOKIE_SECRET=replace_with_a_different_long_random_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
